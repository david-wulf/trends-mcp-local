# ============================================================
# Trends-MCP-Local — Konfiguration
# Diese Datei nach ".env" kopieren und Werte eintragen.
# Google Trends + News brauchen KEINE Keys. YouTube + Reddit schon.
#
# Ablageort der .env ist frei waehlbar (damit Secrets ausserhalb
# des Repos liegen koennen), Priorität:
#   1) Server-Start mit  --env C:\Pfad\zu\.env   (oder Ordner)
#   2) Umgebungsvariable TRENDS_MCP_ENV=C:\Pfad\zu\.env
#   3) Fallback: .env im Projektordner
# ============================================================

# --- YouTube Data API v3 ---
# Google Cloud Console -> Projekt -> "YouTube Data API v3" aktivieren
# -> Anmeldedaten -> API-Schluessel erstellen
YOUTUBE_API_KEY=

# --- Reddit (script-App) ---
# https://www.reddit.com/prefs/apps -> "create app" -> Typ: script
# client_id steht direkt unter dem App-Namen, secret ist das "secret"-Feld.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trends-mcp-local/1.0 by u/DEIN_REDDIT_NAME
